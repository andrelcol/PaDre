# Desenvolvimento local. `npm run supabase:start` preenche `.env.local`.
# Não commitar valores reais. O frontend só lê variáveis com prefixo VITE_.
# A chave abaixo é a chave pública do cliente. Não coloque service_role,
# sb_secret, senha do banco, token de deploy nem keystore em variável VITE_.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Debug Android. O emulador alcança o host por 10.0.2.2.
# No celular com `adb reverse`, use http://127.0.0.1:54321 e gere o APK de novo.
VITE_SUPABASE_URL_ANDROID=http://10.0.2.2:54321

# Origem dos links de e-mail e de convite. Não é o domínio da Play Store.
VITE_PUBLIC_WEB_ORIGIN=http://127.0.0.1:5173

# Host HTTPS futuro dos App Links. Vazio até existir um domínio real.
# VITE_APP_LINK_HOST=

# Usada só por testes de banco e geração de tipos. Fica em .env.local.
# DATABASE_URL=postgresql://postgres:<senha>@127.0.0.1:54322/postgres

# Beta e produção usam outro arquivo, fora do Git (`.env.beta`, ignorado).
# `npm run build:beta` recusa localhost, http e chave administrativa.
# VITE_APP_ENV=beta
# VITE_SUPABASE_URL=https://<projeto>.supabase.co
# VITE_SUPABASE_ANON_KEY=<chave pública anon ou sb_publishable_>
# VITE_PUBLIC_WEB_ORIGIN=https://<site-beta>
# VITE_APP_LINK_HOST=<site-beta>
# Não defina VITE_SUPABASE_URL_ANDROID com 10.0.2.2 numa build beta.
