# Preenchido por `npm run supabase:start`. Não commitar valores reais.
# O frontend só lê variáveis com prefixo VITE_. A chave anon é pública.
# Não coloque service_role, segredo JWT nem senha do banco em variável VITE_.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Debug Android. O emulador alcança o host por 10.0.2.2.
# No celular com `adb reverse`, use http://127.0.0.1:54321 e gere o APK de novo.
VITE_SUPABASE_URL_ANDROID=http://10.0.2.2:54321

# Origem dos links de e-mail e de convite. Não é o domínio da Play Store.
VITE_PUBLIC_WEB_ORIGIN=http://127.0.0.1:5173

# Host HTTPS futuro dos App Links. Vazio até existir um domínio real.
# VITE_APP_LINK_HOST=

# Usada só por testes de banco e geração de tipos. Fica em .env.local.
# DATABASE_URL=postgresql://postgres:<senha>@127.0.0.1:54322/postgres
