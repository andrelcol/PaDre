# Preenchido por `npm run supabase:start`. Não commitar valores reais.
# O frontend só lê variáveis com prefixo VITE_. A chave anon é pública.
# Não coloque service_role, segredo JWT nem senha do banco em variável VITE_.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Usada só por testes de banco e geração de tipos. Fica em .env.local.
# DATABASE_URL=postgresql://postgres:<senha>@127.0.0.1:54322/postgres
